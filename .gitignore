# Obsidian per-device state — each device keeps its own
.obsidian/

# setup script local state (machine-specific)
agency-os/mvp/.setup-progress.json
agency-os/mvp/.setup-config.json
agency-os/mvp/raw/
agency-os/mvp/out/

# Python bytecode — regenerated on every run, per-machine, never committed
__pycache__/
*.pyc
farmhand/node_modules/
farmhand/.next/
